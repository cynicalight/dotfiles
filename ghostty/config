# Automatic dark/light switching
# theme = dark:Rose Pine,light:Rose Pine Dawn
theme = Rose Pine
font-family = "Maple Mono NF CN"
font-thicken = true
font-size = 15

background-opacity = 0.8
background-blur = 15
background-opacity-cells = false
# custom-shader = shaders/bloom025.glsl
custom-shader = shaders/cursor_smear.glsl

macos-titlebar-style = hidden
macos-window-buttons = hidden
mouse-hide-while-typing = true

keybind = shift+enter=csi:13;2u

# Send distinct Ctrl+digit keys for direct tmux window selection.
keybind = ctrl+0=csi:48;5u
keybind = ctrl+1=csi:49;5u
keybind = ctrl+2=csi:50;5u
keybind = ctrl+3=csi:51;5u
keybind = ctrl+4=csi:52;5u
keybind = ctrl+5=csi:53;5u
keybind = ctrl+6=csi:54;5u
keybind = ctrl+7=csi:55;5u
keybind = ctrl+8=csi:56;5u
keybind = ctrl+9=csi:57;5u

